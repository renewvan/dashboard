# TLS terminator for the dashboard, for a LAN-only kiosk served from a Raspberry Pi.
#
# Uses Caddy's internal CA (`tls internal`): no public domain, no Let's Encrypt,
# no port forwarding. Caddy signs the server cert with a local root CA it
# generates on first start, stored in the caddy-data volume.
#
# To make the PWA installable, each client device must trust that root once:
#   1. Copy the root out of the container:
#        docker cp renewvan-caddy:/data/caddy/pki/authorities/local/root.crt .
#   2. Android: Settings -> Security -> Encryption & credentials ->
#      Install a certificate -> CA certificate -> pick root.crt.
#      Then open https://<pi-address> in Chrome.
#
# Set DASHBOARD_HOST to the Pi's LAN address or a local name, e.g.
#   DASHBOARD_HOST=192.168.1.50
# (IPs work; the cert's SAN will match it, so the browser accepts the name.)
# Clients that connect by IP send no SNI (curl, Chrome). Without a default, Caddy has no
# certificate to offer them and the handshake fails with "internal error".
{
    default_sni {$DASHBOARD_HOST}
}

{$DASHBOARD_HOST} {
    # Leaf certs live 90 days (Caddy's default is 12h). sign_with_root makes the root sign them
    # directly: an intermediate would be a 7-day certificate and clamp every leaf to a week.
    # Devices trust the same root, so renewals never need a reinstall.
    tls {
        issuer internal {
            lifetime 2160h
            sign_with_root
        }
    }

    encode zstd gzip

    # History for the charts: same-origin /influx/... forwarded to InfluxDB, so no browser holds a token
    # and there is no CORS (hub docs/adr/0024-history-reaches-browsers-through-a-caddy-influx-proxy.md).
    # Only POST /api/v2/query passes; anything else is refused. Any client Authorization header is
    # replaced (a header_up set overrides it; do not add a `header_up -Authorization`, Caddy applies deletes after sets and would drop the token) and the read-only, bucket-scoped dashboard token is injected from the environment.
    handle_path /influx/* {
        @query {
            method POST
            path /api/v2/query
        }
        handle @query {
            request_body {
                max_size 64KB
            }
            reverse_proxy influxdb:8086 {
                header_up Authorization "Token {env.INFLUXDB_DASHBOARD_TOKEN}"
            }
        }
        handle {
            respond "Forbidden" 403
        }
    }

    # Proxy everything else to the nginx container, which already serves the SPA,
    # the /mqtt WebSocket and the /maps/ basemap (including range requests).
    handle {
        reverse_proxy dashboard:80
    }
}
