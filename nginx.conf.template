# Rendered into conf.d/default.conf at container start by the nginx image's envsubst step, which
# substitutes only INFLUXDB_* variables (NGINX_ENVSUBST_FILTER in the Dockerfile), so nginx's own
# $variables below are left alone.
#
# Single-page app: serve the built static assets, falling back to
# index.html for any unmatched path (client-side page routing has no
# server-side routes to match).
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;

    # MQTT-over-WebSocket, proxied to the broker so a browser only needs the port it loaded the
    # page from (set VITE_MQTT_WS_URL=/mqtt). `mosquitto` is the compose service name. It is
    # resolved per request through Docker's embedded DNS, not once at startup, so nginx still
    # boots when the broker is not up yet and follows it across a recreate.
    location /mqtt {
        resolver 127.0.0.11 valid=10s;
        set $broker http://mosquitto:9001;
        proxy_pass $broker;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        # MQTT keepalive is 60 s; an idle socket must outlive it or nginx drops healthy clients.
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
    }

    # History for the charts, for the kiosk, which loads this container directly (http://localhost) and
    # not through Caddy. Same rules as the Caddyfile's /influx (hub docs/adr/0024): only
    # POST /api/v2/query is forwarded, any client Authorization header is replaced with the read-only,
    # bucket-scoped dashboard token from the environment, the body is capped, and nothing else under
    # /influx is served. Resolved per request, like the broker, so nginx boots without InfluxDB up.
    location = /influx/api/v2/query {
        limit_except POST { deny all; }
        client_max_body_size 64k;
        resolver 127.0.0.11 valid=10s;
        set $influx http://influxdb:8086;
        proxy_pass $influx/api/v2/query$is_args$args;
        proxy_set_header Authorization "Token ${INFLUXDB_DASHBOARD_TOKEN}";
        proxy_set_header Host $host;
    }
    location /influx/ {
        return 403;
    }

    # Offline basemap (see src/lib/mapStyle.ts). The browser reads `basemap.pmtiles` with HTTP Range
    # requests (pmtiles.js), which nginx serves natively for a static file; no tile server. The
    # file is not in the image: the hub bind-mounts that single file into /usr/share/nginx/html/maps/
    # (never the directory, which would hide the fonts and sprites baked into the image).
    # `try_files` with no fallback, so a missing file is a real 404 (the map then draws empty with
    # an "Offline map unavailable" notice) instead of the SPA's index.html, which MapLibre would
    # try to parse as a tile.
    location /maps/ {
        try_files $uri =404;
        # No Cache-Control here, on purpose. `no-cache` makes a browser revalidate every read with
        # If-None-Match, and a `304` to a ranged read is fatal to pmtiles.js ("Bad response code:
        # 304"). It does not need the hint: it keeps the file's ETag from its first read and reloads
        # with `cache: "reload"` when a later read returns a different one, so a replaced
        # basemap.pmtiles is picked up without it. Browsers do not cache partial (206) responses
        # anyway (protomaps/PMTiles#272), so there is nothing stale to guard against.
        # Range responses are the whole point; never let a proxy or gzip rewrite them.
        gzip off;
    }

    # Vite bundles are content-hashed — safe to cache forever.
    # MapLibre's tile-decoding worker is emitted as `maplibre-gl-worker-*.mjs`, and nginx's stock
    # mime.types has no `.mjs` entry, so it went out as application/octet-stream. Browsers refuse to
    # run a module worker with that type ("Worker failed to load"), so the Map page drew no basemap
    # at all, whatever file was mounted. `include mime.types` must come first: a `types` block in a
    # location REPLACES the inherited map, and without the include every .js/.css/.svg here would
    # fall back to octet-stream. A browser that already cached the broken worker (immutable, 1 year)
    # needs a hard reload once after this ships.
    location /assets/ {
        include mime.types;
        types { application/javascript mjs; }
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # The web app manifest. nginx's stock mime.types has no `.webmanifest` entry, so without this it
    # goes out as application/octet-stream. `try_files` with no fallback, so a missing manifest is a
    # real 404 rather than the SPA's index.html (which the browser would fail to parse as JSON).
    # Revalidates like the rest of the shell so a changed name or icon reaches kiosks.
    location = /manifest.webmanifest {
        default_type application/manifest+json;
        add_header Cache-Control "no-cache";
        try_files $uri =404;
    }

    # Everything else resolves to index.html (SPA fallback). It must
    # always revalidate, or kiosk browsers keep serving a stale build
    # from heuristic cache after a new image is deployed.
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
}
