# Copy to `.env` (or set as build-time environment) before `npm run build`
# / `npm run dev` — Vite inlines VITE_* vars at build time, so a real
# deployment sets these before building the image (see hub's
# `docker-compose.yml` `dashboard:` service, which passes
# RENEWVAN_WS_URL/DASHBOARD_MQTT_USERNAME/DASHBOARD_MQTT_PASSWORD through
# as build args if you customize the Dockerfile for that, or bake a
# per-deployment .env before building).

# Mosquitto's WS listener as reachable from a browser/phone on the van's
# network (not a container-internal hostname).
VITE_MQTT_WS_URL=ws://<host>:9001

# Read-scoped credentials. Leave blank while the broker allows anonymous
# access (hub's reference docker/mosquitto/config).
VITE_MQTT_USERNAME=
VITE_MQTT_PASSWORD=

# Optional JSON override for the relay id -> label mapping shown on the
# Switches tab (dashboard-side only, not a wire field). See
# src/config/relayLabels.ts for the built-in defaults.
# VITE_RELAY_LABELS={"lights_ceiling":"Ceiling lights"}
