# Two ways this gets set, and they used to disagree (fixed):
#
# 1. Local dev (`npm run dev`) / a custom build: copy this to `.env`
#    before building -- Vite inlines VITE_* at build time.
# 2. The published Docker image (what `hub`'s docker-compose.yml runs):
#    the image is built once in CI with none of these set, so
#    docker/generate-env-js.sh (an nginx docker-entrypoint.d script)
#    writes them into a runtime env.js from the *container's* environment
#    at startup instead -- see src/config/runtimeEnv.ts. hub's
#    docker-compose.yml `dashboard:` service passes these same VITE_*
#    names through as container env vars for exactly this.

# Broker WebSocket. `/mqtt` (recommended in the container) means "this page's own
# host": the image's nginx proxies it to the compose service `mosquitto:9001`, so a
# browser/phone/kiosk needs only the port it loaded the page from, on the LAN, over
# Tailscale or WireGuard, and after a router/IP change. Or a full URL a browser can
# reach (not a container-internal hostname), e.g. `vp dev` against a broker:
VITE_MQTT_WS_URL=ws://<host>:9001

# Read-scoped credentials. Leave blank while the broker allows anonymous
# access (hub's reference docker/mosquitto/config).
VITE_MQTT_USERNAME=
VITE_MQTT_PASSWORD=

